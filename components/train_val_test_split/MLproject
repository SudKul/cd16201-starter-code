name: train_val_test_split

entry_points:
  main:
    parameters:
      project_root: {type: string}
      run_dir: {type: string}
      input: {type: string, description: Completed local clean.csv}
      output_dir: {type: string, description: New split directory inside the run directory}
      test_size: {type: float, description: Held-out fraction strictly between zero and one}
      random_seed: {type: int, default: 42}
      stratify_by: {type: string, default: none}
    command: >-
      python run.py --project_root "{project_root}" --run_dir "{run_dir}"
      --input "{input}" --output_dir "{output_dir}" --test_size {test_size}
      --random_seed {random_seed} --stratify_by "{stratify_by}"
