name: get_data

entry_points:
  main:
    parameters:
      project_root: {type: string}
      run_dir: {type: string}
      sample: {type: string, description: Bundled sample1.csv or sample2.csv}
      output: {type: string, description: New CSV output inside the run directory}
    command: >-
      python run.py --project_root "{project_root}" --run_dir "{run_dir}"
      --sample "{sample}" --output "{output}"
