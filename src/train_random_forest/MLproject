name: train_random_forest
entry_points:
  main:
    parameters:
      project_root: {type: str}
      run_dir: {type: str}
      trainval: {type: str}
      split: {type: str}
      output_dir: {type: str}
      rf_config: {type: str}
      val_size: {type: float}
      random_seed: {type: int, default: 42}
      stratify_by: {type: str, default: none}
      max_tfidf_features: {type: int, default: 5}
    command: >-
      python run.py --project_root "{project_root}" --run_dir "{run_dir}"
      --trainval "{trainval}" --split "{split}" --output_dir "{output_dir}"
      --rf_config "{rf_config}" --val_size {val_size} --random_seed {random_seed}
      --stratify_by "{stratify_by}" --max_tfidf_features {max_tfidf_features}
