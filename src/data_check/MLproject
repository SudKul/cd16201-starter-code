name: data_check

entry_points:
  main:
    parameters:
      project_root: {type: string, description: Project root for local CSV paths}
      csv: {type: string, description: Current local CSV to test}
      ref: {type: string, description: Initialized fixed reference CSV}
      kl_threshold: {type: float, description: Maximum KL divergence for neighborhood groups}
      min_price: {type: float, description: Minimum accepted price}
      max_price: {type: float, description: Maximum accepted price}
      report: {type: string, description: JUnit report path inside the current run}
    command: >-
      python -m pytest . -vv --project_root "{project_root}"
      --csv "{csv}" --ref "{ref}" --kl_threshold {kl_threshold}
      --min_price {min_price} --max_price {max_price}
      --junitxml "{report}"
