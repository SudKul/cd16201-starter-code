name: nyc_airbnb
conda_env: conda.yml

entry_points:
  main:
    parameters:
      steps:
        description: Comma-separated pipeline stages, or all for the default sequence
        type: str
        default: all
      hydra_options:
        description: Additional Hydra configuration overrides
        type: str
        default: ''
    command: >-
      python -m components.launch --steps {steps} --hydra_options {hydra_options}
